MVA_ENV=development
# AI is disabled by default. Never commit real credentials.
MVA_AI_ENABLED=false
MVA_AI_PROVIDER=openai-compatible
# Example format: https://provider.example/v1 (must support /chat/completions)
MVA_AI_API_BASE_URL=
MVA_AI_API_KEY=
MVA_AI_MODEL=

# Hugging Face token for speech-to-text (never commit a real token)
HF_TOKEN=
